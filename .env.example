# Database connection string
DATABASE_URL="file:./dev.db"

# MikroTik RouterOS Credentials
MIKROTIK_HOST="192.168.88.1"
MIKROTIK_PORT="8728"
MIKROTIK_USER="admin"
MIKROTIK_PASSWORD="your-strong-password"

# Payment Gateway Configuration ('azampay' | 'selcom' | 'mock')
PAYMENT_GATEWAY_PROVIDER="mock"

# AzamPay API Credentials
AZAMPAY_APP_NAME="MtaaWiFi"
AZAMPAY_CLIENT_ID="your_azampay_client_id"
AZAMPAY_CLIENT_SECRET="your_azampay_client_secret"
AZAMPAY_API_KEY="your_azampay_api_key"
AZAMPAY_ENV="sandbox" # "sandbox" or "production"

# Selcom APIGW Credentials
SELCOM_VENDOR_ID="MTAAWIFI"
SELCOM_API_KEY="your_selcom_api_key"
SELCOM_API_SECRET="your_selcom_api_secret"
SELCOM_ENV="sandbox" # "sandbox" or "production"

# App Branding
NEXT_PUBLIC_APP_NAME="MtaaWiFi Tanzania"
NEXT_PUBLIC_APP_URL="https://mtaawifi.tz"
NEXT_PUBLIC_DEFAULT_CURRENCY="TZS"
NEXT_PUBLIC_DEFAULT_LOCALE="sw"
